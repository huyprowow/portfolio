{
  "functions": {
    "public/assets/**/*.glb": {
      "maxDuration": 30
    },
    "public/assets/**/*.fbx": {
      "maxDuration": 30
    },
    "public/assets/**/*.pmx": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/assets/:path*.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    },
    {
      "source": "/assets/:path*.fbx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    },
    {
      "source": "/assets/:path*.pmx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        }
      ]
    }
  ]
}
